set dotenv-load := true
set dotenv-filename := ".env"
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

init-env:
    if [[ ! -e .env ]]; then cp deploy.example.env .env; fi

install:
    ./install.sh

deploy:
    ./deploy.sh

check:
    #!/usr/bin/env bash
    set -Eeuo pipefail
    bash -n install.sh deploy.sh
    for command in git podman sudo systemd-analyze sed sort grep cp mktemp ip awk id getent; do command -v "$command" >/dev/null || { printf 'check: required command not found: %s\n' "$command" >&2; exit 1; }; done
    [[ -r .env ]] || { printf "check: missing deploy/.env; run 'just init-env' first\n" >&2; exit 1; }
    actual_keys="$(sed -nE 's/^([A-Z][A-Z0-9_]*)=.*/\1/p' .env | sort)"
    expected_keys="$(printf '%s\n' LABELLO_API_DOMAIN LABELLO_APP_DOMAIN LABELLO_BACKEND_IP LABELLO_GIT_BRANCH LABELLO_GIT_REMOTE | sort)"
    [[ "$actual_keys" == "$expected_keys" ]] || { printf 'check: deploy/.env must define exactly the five documented variables once\n' >&2; exit 1; }
    if grep -Ev '^[[:space:]]*(#.*)?$|^(LABELLO_APP_DOMAIN|LABELLO_API_DOMAIN|LABELLO_BACKEND_IP|LABELLO_GIT_REMOTE|LABELLO_GIT_BRANCH)=.+$' .env | grep -q .; then printf 'check: deploy/.env contains an unsupported line\n' >&2; exit 1; fi
    validate_domain() { local domain="$1" label; local -a labels; (( ${#domain} <= 253 )) && [[ "$domain" == *.* && "$domain" != *..* ]] || return 1; IFS='.' read -r -a labels <<< "$domain"; for label in "${labels[@]}"; do (( ${#label} >= 1 && ${#label} <= 63 )) && [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1; done; }
    validate_ipv4() { local value="$1" a b c d extra octet; IFS='.' read -r a b c d extra <<< "$value"; [[ -n "$a" && -n "$b" && -n "$c" && -n "$d" && -z "${extra:-}" ]] || return 1; for octet in "$a" "$b" "$c" "$d"; do [[ "$octet" =~ ^(0|[1-9][0-9]{0,2})$ ]] && (( 10#$octet <= 255 )) || return 1; done; (( 10#$a != 0 && 10#$a != 127 && 10#$a < 224 )); }
    validate_domain "$LABELLO_APP_DOMAIN" || { printf 'check: invalid LABELLO_APP_DOMAIN\n' >&2; exit 1; }
    validate_domain "$LABELLO_API_DOMAIN" || { printf 'check: invalid LABELLO_API_DOMAIN\n' >&2; exit 1; }
    [[ "${LABELLO_APP_DOMAIN,,}" != "${LABELLO_API_DOMAIN,,}" ]] || { printf 'check: application and API domains must be distinct\n' >&2; exit 1; }
    validate_ipv4 "$LABELLO_BACKEND_IP" || { printf 'check: invalid LABELLO_BACKEND_IP\n' >&2; exit 1; }
    ip -o -4 address show | awk -v expected="$LABELLO_BACKEND_IP" '{ split($4, address, "/"); if (address[1] == expected) found=1 } END { exit !found }' || { printf 'check: LABELLO_BACKEND_IP is not assigned to this host\n' >&2; exit 1; }
    [[ "$LABELLO_GIT_REMOTE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { printf 'check: invalid Git remote name\n' >&2; exit 1; }
    git check-ref-format --branch "$LABELLO_GIT_BRANCH" >/dev/null || { printf 'check: invalid Git branch name\n' >&2; exit 1; }
    grep -Fxq 'FROM docker.io/library/rust:1.97.1-alpine3.22 AS builder' Containerfile
    grep -Fxq 'FROM docker.io/library/caddy:2.10.2-alpine' Containerfile
    grep -Fq 'cargo install trunk --version 0.21.14 --locked' Containerfile
    grep -Fq 'addgroup -g 10001 labello' Containerfile
    grep -Fq -- '-u 10001 -G labello labello' Containerfile
    grep -Fq 'setcap -r /usr/bin/caddy' Containerfile
    grep -Fxq 'deploy/.env' ../.containerignore
    grep -Fxq 'labello.server.toml' ../.containerignore
    grep -Fxq 'UserNS=keep-id:uid=10001,gid=10001' quadlet/labello.pod.template
    grep -Fxq 'PublishPort=@LABELLO_BACKEND_IP@:24180:8080/tcp' quadlet/labello.pod.template
    grep -Fxq 'PublishPort=@LABELLO_BACKEND_IP@:24181:8081/tcp' quadlet/labello.pod.template
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "$temp_dir"' EXIT
    sed -e "s/@LABELLO_BACKEND_IP@/${LABELLO_BACKEND_IP}/g" quadlet/labello.pod.template > "$temp_dir/labello.pod"
    cp quadlet/labello-api.container quadlet/labello-web.container "$temp_dir/"
    generator=
    for candidate in /usr/lib/systemd/system-generators/podman-system-generator /usr/libexec/podman/quadlet /usr/libexec/podman/podman-system-generator; do if [[ -x "$candidate" ]]; then generator="$candidate"; break; fi; done
    [[ -n "$generator" ]] || { printf 'check: Podman Quadlet generator not found\n' >&2; exit 1; }
    mkdir -p "$temp_dir/normal" "$temp_dir/early" "$temp_dir/late"
    QUADLET_UNIT_DIRS="$temp_dir" "$generator" --user "$temp_dir/normal" "$temp_dir/early" "$temp_dir/late"
    systemd-analyze verify "$temp_dir/normal/labello-pod.service" "$temp_dir/normal/labello-api.service" "$temp_dir/normal/labello-web.service"
    sed -e "s/@LABELLO_APP_DOMAIN@/${LABELLO_APP_DOMAIN}/g" -e "s/@LABELLO_API_DOMAIN@/${LABELLO_API_DOMAIN}/g" -e "s/@LABELLO_BACKEND_IP@/${LABELLO_BACKEND_IP}/g" Caddyfile.external.template > "$temp_dir/Caddyfile.external"
    cp Caddyfile "$temp_dir/Caddyfile"
    if getent passwd labello >/dev/null 2>&1; then
        labello_uid="$(id -u labello)"
        rootless=(sudo -n -H -u labello env "XDG_RUNTIME_DIR=/run/user/${labello_uid}" podman)
        if (cd /var/lib/labello && "${rootless[@]}" image exists localhost/labello:current 2>/dev/null); then
            (cd /var/lib/labello && "${rootless[@]}" run --rm --interactive --network none --read-only --read-only-tmpfs --cap-drop all --security-opt no-new-privileges --user labello:labello --entrypoint /usr/bin/caddy localhost/labello:current validate --config - --adapter caddyfile) < "$temp_dir/Caddyfile"
            (cd /var/lib/labello && "${rootless[@]}" run --rm --interactive --network none --read-only --read-only-tmpfs --cap-drop all --security-opt no-new-privileges --user labello:labello --entrypoint /usr/bin/caddy localhost/labello:current validate --config - --adapter caddyfile) < "$temp_dir/Caddyfile.external"
        else
            printf '%s\n' 'check: no accessible rootless current image; Caddy binary validation is deferred to deploy'
        fi
    else
        printf '%s\n' 'check: labello account is not installed; Caddy binary validation is deferred to deploy'
    fi

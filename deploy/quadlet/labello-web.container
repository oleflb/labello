[Unit]
Description=Labello Caddy container

[Container]
ContainerName=labello-web
Image=localhost/labello:current
Pull=never
Pod=labello.pod
StartWithPod=true
Entrypoint=/usr/bin/caddy
Exec=run --config /etc/caddy/Caddyfile --adapter caddyfile
User=labello
Group=labello
EnvironmentFile=/etc/labello/caddy.env
Environment=XDG_DATA_HOME=/data
Environment=XDG_CONFIG_HOME=/config
Volume=/var/lib/labello/caddy/data:/data:rw,Z
Volume=/var/lib/labello/caddy/config:/config:rw,Z
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
StopSignal=SIGTERM
StopTimeout=30
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=2
TimeoutStopSec=60

[Unit]
Description=Labello API container

[Container]
ContainerName=labello-api
Image=localhost/labello:current
Pull=never
Pod=labello.pod
StartWithPod=true
Entrypoint=/usr/local/bin/labello-server
User=labello
Group=labello
Environment=LABELLO_CONFIG=/etc/labello/labello.server.toml
EnvironmentFile=/etc/labello/labello.env
Volume=/etc/labello/labello.server.toml:/etc/labello/labello.server.toml:ro
Volume=/var/lib/labello/datasets:/var/lib/labello/datasets:rw
Volume=/var/lib/labello/imports:/var/lib/labello/imports:ro
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
StopSignal=SIGTERM
StopTimeout=300
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=2
TimeoutStopSec=330

# This file is read by systemd and passed to labello-server. Uncomment and
# configure all three GITHUB_* values when LABELLO_AUTH_MODE=github. Leave all
# three commented when LABELLO_AUTH_MODE=loopback.
# GITHUB_CLIENT_ID=REPLACE_ME
# GITHUB_CLIENT_SECRET=REPLACE_ME
# GITHUB_REDIRECT_URI=https://REPLACE_ME/api/auth/github/callback
RUST_LOG=labello_server=info,labello_api=info,labello_storage=info
LABELLO_LOG_FORMAT=json

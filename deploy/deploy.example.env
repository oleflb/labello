# Local deployment paths. All path values must be canonical, absolute, and
# contain no whitespace. Setup creates missing private path components with the
# corresponding account ownership without changing existing directory metadata.
# Copy this file to deploy/.env; that file is ignored by Git.
LABELLO_DEPLOY_ROOT=/srv/labello
LABELLO_BUILD_ROOT=/var/lib/labello-build/labello
LABELLO_REPO_DIR=/srv/labello/source
LABELLO_DATASETS_ROOT=/var/lib/labello/datasets
LABELLO_BACKUP_DIR=/var/backups/labello
LABELLO_CLIENT_CONFIG=/etc/labello/labello.client.json
LABELLO_SERVER_CONFIG=/etc/labello/labello.server.toml
LABELLO_SERVER_ENV=/etc/labello/labello.env
LABELLO_SYSTEMD_UNIT_PATH=/etc/systemd/system/labello.service
LABELLO_WEB_SYSTEMD_UNIT_PATH=/etc/systemd/system/labello-web.service
LABELLO_TRUNK_CONFIG=/etc/labello/labello.web.trunk.toml

# Listener addresses. Loopback authentication defaults to these values when
# they are omitted and accepts explicit loopback overrides. GitHub
# authentication requires both values and permits private or wildcard binds.
# LABELLO_BIND=127.0.0.1:8080
# LABELLO_WEB_BIND=127.0.0.1:8081

# Authentication policy enforced by the deployment recipes. It defaults to
# "github". Override it only for direct local/SSH-tunnel access without OAuth.
# LABELLO_AUTH_MODE=loopback

# Existing unprivileged account that owns releases, backups, and production data.
LABELLO_SERVICE_USER=REPLACE_ME
LABELLO_SERVICE_GROUP=REPLACE_ME
# Separate system account with no membership in LABELLO_SERVICE_GROUP. It owns
# only LABELLO_BUILD_ROOT; it does not need a login home directory.
LABELLO_BUILD_USER=labello-build
LABELLO_BUILD_GROUP=labello-build
LABELLO_SERVICE_NAME=labello.service
LABELLO_WEB_SERVICE_NAME=labello-web.service

# Reproducible build tools installed for LABELLO_BUILD_USER by just setup.
# Trunk is downloaded from its exact GitHub release and verified against the
# archive and executable SHA-256 values pinned in deploy/trunk.sha256.
LABELLO_RUST_TOOLCHAIN=1.97.1
LABELLO_RUSTUP_BIN=/usr/bin/rustup
LABELLO_TRUNK_VERSION=0.21.14

# Update source and local verification.
LABELLO_GIT_REMOTE=origin
LABELLO_GIT_BRANCH=main
# Health URLs are requested locally by the deployment recipes. They may differ
# from wildcard binds, but must reach the corresponding listener from this host.
LABELLO_HEALTH_URL=http://127.0.0.1:8080/health
LABELLO_WEB_HEALTH_URL=http://127.0.0.1:8081/labello.client.json
LABELLO_HEALTH_ATTEMPTS=30

# Leave empty to use the updater's verified full-root tar archive. An optional
# hook must be an absolute executable path.
LABELLO_BACKUP_HOOK=

# Per-invocation controls. Prefer overriding these on the command line, for
# example: LABELLO_BUILD_ONLY=true just update
LABELLO_BUILD_ONLY=false
LABELLO_RUN_TESTS=true
LABELLO_ASSUME_YES=false

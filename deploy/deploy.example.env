# Public browser and API hostnames. DNS points to the external Caddy host.
LABELLO_APP_DOMAIN=labello.example.com
LABELLO_API_DOMAIN=api.labello.example.com

# Stable private IPv4 address assigned to the Labello host.
LABELLO_BACKEND_IP=10.0.0.20

# Git remote and branch deployed by `just deploy`.
LABELLO_GIT_REMOTE=origin
LABELLO_GIT_BRANCH=main
